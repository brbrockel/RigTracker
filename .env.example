# Copy to .env for local development. Never commit .env.
# Local Postgres from `pnpm dev:services` (docker compose).
DATABASE_URL=postgres://rigtracker:rigtracker@127.0.0.1:15433/rigtracker
PORT=4000
# Base URL of sign-in links (the Vite dev server in development).
APP_URL=http://localhost:5173
# Encrypts authenticator-app keys (required in production). Make one: openssl rand -hex 32
APP_SECRET=
# Email stays off (the mail guard); nothing sends email yet.
MAIL_MODE=off

# Deploy script only: a GitHub token with write:packages, to push the image to GHCR.
GITHUB_GHCR_TOKEN=

# Copy to .env for local development. Never commit .env.
# Local Mongo from `pnpm dev:services` (docker compose).
MONGO_URI=mongodb://127.0.0.1:17017/rigtracker
PORT=4000
# Base URL of sign-in links (the Vite dev server in development).
APP_URL=http://localhost:5173

# Deploy script only: a GitHub token with write:packages, to push the image to GHCR.
GITHUB_GHCR_TOKEN=

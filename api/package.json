{
  "name": "rigtracker-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.json",
    "prisma": "prisma",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "seed": "ts-node prisma/seed.ts",
    "import:xlsx": "ts-node scripts/import_xlsx.ts \"../UConn Skydiving Gear.xlsx\""
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/mongoose": "^10.0.0",
    "@prisma/client": "^5.0.0",
    "mongoose": "^7.0.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "xlsx": "^0.18.5",
    "reflect-metadata": "^0.1.13"
  },
  "devDependencies": {
    "prisma": "^5.0.0",
    "ts-node": "^10.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.17"
  }
}

{
  "name": "rigtracker-monorepo",
  "version": "2.0.0-alpha.5",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev:services": "docker compose up -d --wait",
    "dev:services:stop": "docker compose stop",
    "dev:web": "pnpm --filter rigtracker-web dev",
    "dev:api": "pnpm --filter rigtracker-api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.4.0",
      "proxy-addr": "^2.0.8",
      "path-to-regexp@<0.1.13": "^0.1.13",
      "qs": "^6.16.1",
      "body-parser@<1.20.6": "^1.20.8",
      "ip-address": "^10.7.4",
      "file-type": "^21.3.4",
      "fflate": "^0.8.3"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2"
  }
}

{
  "name": "rigtracker-monorepo",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "workspaces": [
    "web",
    "api",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm -w -r build"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.4.0",
      "proxy-addr": "^2.0.8",
      "path-to-regexp@<0.1.13": "^0.1.13",
      "qs": "^6.16.1",
      "body-parser@<1.20.6": "^1.20.8",
      "ip-address": "^10.7.4",
      "file-type": "^21.3.4",
      "fflate": "^0.8.3"
    }
  }
}
